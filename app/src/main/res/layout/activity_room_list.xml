<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity_room_list">

    <RelativeLayout
        android:id="@+id/maphoto"
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="#E3D681"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:src="@drawable/dragon"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />


    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/notif"
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/game3"
        android:background="@drawable/stroke"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp" >

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_centerInParent="true"
            android:src="@drawable/notification" />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/notif"
        android:layout_alignTop="@id/notif"
        android:layout_alignBottom="@id/notif">

        <RelativeLayout
            android:id="@+id/vert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:background="@drawable/room_number">


            <ImageView
                android:id="@+id/found"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_centerVertical="true"
                android:src="@drawable/trouve"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                android:layout_marginStart="@dimen/_6sdp"/>

            <TextView
                android:id="@+id/nombredesalons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/found"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:textStyle="bold"
                android:textColor="#177E51"
                android:fontFamily="@font/raleway"/>


        </RelativeLayout>

        <RelativeLayout
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_toEndOf="@id/vert"
            android:layout_centerVertical="true"
            android:layout_marginStart="-15dp">


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.5"
                android:background="@drawable/rounded_noir"/>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/_2sdp"
                android:src="@drawable/searcheic"/>

        </RelativeLayout>


    </RelativeLayout>
    <RelativeLayout
            android:id="@+id/serc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_below="@id/maphoto">

            <TextView
                android:id="@+id/upcoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_22ssp"
                android:textColor="@color/black"
                android:fontFamily="@font/bienalbold"
                android:text="Upcoming"/>

            <TextView
                android:id="@+id/compet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_22ssp"
                android:textColor="@color/black"
                android:layout_marginTop="@dimen/_1sdp"
                android:layout_below="@id/upcoming"
                android:fontFamily="@font/bienalbold"
                android:text="Competitions"/>

        </RelativeLayout>
    <RelativeLayout
        android:id="@+id/allroom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/serc"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/rounded_noir"
        android:layout_alignStart="@id/serc">


        <TextView
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_15sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:text="All"
            android:gravity="center"
            android:textColor="#FBFBFB"
            android:textStyle="bold" />

    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/oneplayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/serc"
        android:layout_toEndOf="@id/allroom"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/rounded_gray">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_15sdp"
            android:layout_marginStart="@dimen/_7sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_7sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:text="Completed"
            android:gravity="center"
            android:textColor="#535252"
            android:textStyle="bold" />

    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/twoplayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/serc"
        android:layout_toEndOf="@id/oneplayer"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/rounded_gray">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_15sdp"
            android:layout_marginStart="@dimen/_7sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_7sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:text="one Player"
            android:gravity="center"
            android:textColor="#535252"
            android:textStyle="bold" />

    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/pp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/allroom"
        android:layout_marginTop="@dimen/_5sdp">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/myrecycler_room_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>



    </RelativeLayout>

</RelativeLayout>