<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ombre -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80292626"/> <!-- Couleur de l'ombre -->
            <corners android:radius="8dp"/> <!-- Coins arrondis -->
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp"/> <!-- Espace entre l'ombre et l'image -->
        </shape>
    </item>

    <!-- Image réelle -->
    <item android:right="4dp" android:bottom="4dp">
        <bitmap
            android:src="@drawable/game3"
        android:gravity="center"/>
    </item>
</layer-list>
