<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ombre -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#801AF1D0" /> <!-- Couleur de l'ombre noire avec opacité -->
            <corners android:radius="5dp" />
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp" />
        </shape>
    </item>

    <!-- Fond -->
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#47F6DC" /> <!-- Couleur du fond -->
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
